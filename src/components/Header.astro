---
import { brand } from '../config/brand';
import { client } from '../data/client';

const angebote = [
  { label: 'Freilandeier',    href: '/freilandeier' },
  { label: 'Milchproduktion', href: '/milchproduktion' },
  { label: 'Kindernachmittage', href: '/kinderprogramm' },
  { label: 'Ackerbau',        href: '/ackerbau' },
];

const nav = [
  { label: 'Home',     href: '/' },
  { label: 'Angebote', href: '/', children: angebote },
  { label: 'Über uns', href: '/ueber-uns' },
  { label: 'Kontakt',  href: '/kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm"
  transition:persist
>
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a
      href="/"
      class="font-heading text-xl font-bold uppercase tracking-wide text-primary transition-opacity hover:opacity-80"
    >
      {brand.name}
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Hauptnavigation">
      {nav.map(({ label, href, children }) => {
        if (!children) {
          const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
          return (
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                isActive ? 'bg-primary/10 text-primary' : 'text-text-muted hover:text-text',
              ]}
            >
              {label}
            </a>
          );
        }

        const childActive = children.some((c) => currentPath.startsWith(c.href));
        return (
          <div class="relative" data-dropdown>
            <button
              type="button"
              data-dropdown-toggle
              aria-expanded="false"
              aria-haspopup="true"
              class:list={[
                'flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium transition-colors',
                childActive ? 'bg-primary/10 text-primary' : 'text-text-muted hover:text-text',
              ]}
            >
              {label}
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              data-dropdown-menu
              hidden
              class="absolute left-0 top-full z-50 mt-2 w-64 rounded-lg border border-border bg-background p-2 shadow-lg"
            >
              {children.map(({ label, href }) => (
                <a
                  href={href}
                  class="block rounded-md px-3 py-2.5 text-sm font-medium text-text-muted transition-colors hover:bg-surface hover:text-primary"
                >
                  {label}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </nav>

    <!-- Desktop CTA + phone -->
    <div class="hidden items-center gap-4 lg:flex">
      <a
        href={`tel:${client.phoneForTel}`}
        class="text-sm font-semibold text-text hover:text-primary transition-colors"
      >
        {client.phoneFormatted}
      </a>
      <a
        href="/freilandeier"
        class="inline-flex min-h-[44px] items-center rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Eier-Abo
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-text-muted hover:bg-surface lg:hidden"
    >
      <span class="sr-only">Menü öffnen</span>
      <svg id="menu-icon-open" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="hidden size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 pb-6 pt-2 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobilnavigation">
      <a href="/" class="rounded-md px-3 py-3 text-base font-medium text-text-muted hover:bg-surface hover:text-text">
        Home
      </a>
      <p class="px-3 pb-1 pt-3 text-xs font-bold uppercase tracking-widest text-accent">Angebote</p>
      {angebote.map(({ label, href }) => (
        <a
          href={href}
          class="rounded-md px-3 py-3 text-base font-medium text-text-muted transition-colors hover:bg-surface hover:text-text"
        >
          {label}
        </a>
      ))}
      <a href="/ueber-uns" class="rounded-md px-3 py-3 text-base font-medium text-text-muted transition-colors hover:bg-surface hover:text-text">
        Über uns
      </a>
      <a href="/kontakt" class="rounded-md px-3 py-3 text-base font-medium text-text-muted transition-colors hover:bg-surface hover:text-text">
        Kontakt
      </a>
    </nav>

    <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4">
      <a
        href={`tel:${client.phoneForTel}`}
        class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
      >
        <svg class="size-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {client.phoneFormatted}
      </a>
      <a
        href="/freilandeier"
        class="flex min-h-[44px] items-center justify-center rounded-md bg-accent px-5 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90"
      >
        Eier-Abo bestellen
      </a>
    </div>
  </div>
</header>

<script>
  (() => {
    const headerEl = document.querySelector('header');
    const btnEl = document.getElementById('menu-toggle');
    const menuEl = document.getElementById('mobile-menu');
    const iconOpenEl = document.getElementById('menu-icon-open');
    const iconCloseEl = document.getElementById('menu-icon-close');

    if (!headerEl || !btnEl || !menuEl || !iconOpenEl || !iconCloseEl) return;

    const header = /** @type {HTMLElement} */ (headerEl);
    const btn = /** @type {HTMLButtonElement} */ (btnEl);
    const menu = /** @type {HTMLElement} */ (menuEl);
    const iconOpen = /** @type {HTMLElement} */ (iconOpenEl);
    const iconClose = /** @type {HTMLElement} */ (iconCloseEl);
    if (header.dataset.init === 'true') return;
    header.dataset.init = 'true';

    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    // ── Mobile Drawer ────────────────────────────────────────────────
    const setMenuOpen = (nextOpen: boolean) => {
      if (isDesktop()) nextOpen = false;
      btn.setAttribute('aria-expanded', String(nextOpen));
      menu.classList.toggle('hidden', !nextOpen);
      iconOpen.classList.toggle('hidden', nextOpen);
      iconClose.classList.toggle('hidden', !nextOpen);
    };

    btn.addEventListener('click', () => {
      if (isDesktop()) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    });

    menu.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('a[href]')) setMenuOpen(false);
    });

    // ── Desktop Dropdown ─────────────────────────────────────────────
    const closeDropdowns = () => {
      header.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dd) => {
        dd.querySelector<HTMLElement>('[data-dropdown-menu]')!.hidden = true;
        dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]')!.setAttribute('aria-expanded', 'false');
      });
    };

    const toggleDropdown = (dd: HTMLElement) => {
      const menuEl2 = dd.querySelector<HTMLElement>('[data-dropdown-menu]')!;
      const btnEl2 = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]')!;
      const isOpen = !menuEl2.hidden;
      closeDropdowns();
      if (!isOpen) {
        menuEl2.hidden = false;
        btnEl2.setAttribute('aria-expanded', 'true');
      }
    };

    header.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dd) => {
      dd.querySelector('[data-dropdown-toggle]')?.addEventListener('click', () => toggleDropdown(dd));
      dd.addEventListener('mouseenter', () => {
        if (isDesktop()) {
          closeDropdowns();
          dd.querySelector<HTMLElement>('[data-dropdown-menu]')!.hidden = false;
          dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]')!.setAttribute('aria-expanded', 'true');
        }
      });
      dd.addEventListener('mouseleave', closeDropdowns);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!target.closest('[data-dropdown]')) closeDropdowns();
    });

    // ── Schliessen nach Navigation / Resize ─────────────────────────
    document.addEventListener('astro:before-preparation', () => {
      setMenuOpen(false);
      closeDropdowns();
    });

    document.addEventListener('astro:after-swap', () => {
      setMenuOpen(false);
      closeDropdowns();
      syncActiveLinks();
    });

    const syncActiveLinks = () => {
      const path = window.location.pathname;
      const setActive = (link: HTMLAnchorElement, active: boolean) => {
        link.classList.toggle('bg-primary/10', active);
        link.classList.toggle('text-primary', active);
        link.classList.toggle('text-text-muted', !active);
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      };

      header.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Hauptnavigation"] > a').forEach((link) => {
        const href = link.getAttribute('href') || '';
        setActive(link, path === href || (href !== '/' && path.startsWith(href)));
      });

      header.querySelectorAll<HTMLAnchorElement>('#mobile-menu nav a').forEach((link) => {
        const href = link.getAttribute('href') || '';
        link.classList.toggle('bg-primary/10', path === href || (href !== '/' && path.startsWith(href)));
        link.classList.toggle('text-primary', path === href || (href !== '/' && path.startsWith(href)));
        if (path === href || (href !== '/' && path.startsWith(href))) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });

      header.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dd) => {
        const childActive = Array.from(
          dd.querySelectorAll<HTMLAnchorElement>('[data-dropdown-menu] a'),
        ).some((a) => path.startsWith(a.getAttribute('href') || ''));
        const btnEl2 = dd.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
        if (!btnEl2) return;
        btnEl2.classList.toggle('bg-primary/10', childActive);
        btnEl2.classList.toggle('text-primary', childActive);
        btnEl2.classList.toggle('text-text-muted', !childActive);
      });
    };

    window.addEventListener('resize', () => {
      setMenuOpen(false);
      closeDropdowns();
    });

    // Keyboard: Escape schliesst alles
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenuOpen(false);
        closeDropdowns();
      }
    });

    setMenuOpen(false);
    closeDropdowns();
  })();
</script>