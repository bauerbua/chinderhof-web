---
/**
 * Icon – eigener Hof-Motiv-Icon-Satz (Design-System §6).
 *
 * Stil: minimal, 1.75px Strich, runde Enden; Farbe über `text-*`.
 * Jedes Motiv ist ein Zeichen unter `name` (Markier-Markup im SVG-body).
 */
/** Design-System §6: minimaler Strich-Icon-Satz (1.75px, runde Enden). */
interface Props {
  name: IconName;
  class?: string;
}

