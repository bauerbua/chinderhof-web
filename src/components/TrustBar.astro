---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

interface TrustItem {
  label: string;
  value?: string;
  icon?: IconName;
}

interface Props {
  items?: TrustItem[];
}

const { items = [
  { value: '9 Monate', label: 'Weidegang & Gras/Heu', icon: 'sun' },
  { value: 'Milch',    label: 'für Emmentaler AOP',   icon: 'wheat' },
  { value: '3 Monate', label: 'Winter mit Silage',    icon: 'milkcan' },
  { label: 'Freilandeier vom Hof', icon: 'egg' },
] } = Astro.props;
---

<section class="border-y border-border bg-surface" aria-label="Vertrauenssignale">
  <div class="mx-auto max-w-site overflow-x-auto px-4 py-5 sm:px-6 sm:py-6">
    <ul class="flex flex-wrap items-center justify-between gap-6 sm:gap-8 lg:justify-center lg:gap-16" role="list">
      {items.map(({ label, value, icon }) => (
        <li class="flex shrink-0 items-center gap-2.5 text-sm sm:text-base">
          <Icon name={icon ?? 'check'} class="size-5 shrink-0 text-terracotta" />
          <span class="font-heading font-semibold text-text">
            {value && <span class="text-primary">{value} </span>}
            {label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>