---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand } from '../config/brand';
import { client } from '../data/client';
import { heroImage as localHeroImage } from '../config/images';
import Mascot from './Mascot.astro';

// Fallback Unsplash URL used until a local image is added to
// src/assets/images/hero/ and registered in src/config/images.ts
const PLACEHOLDER = 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&q=80';

interface Props {
  topper?: string;
  heading?: string;
  doodleWord?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  imageSrc?: ImageMetadata | string | null;
  imageAlt?: string;
}

const {
  topper = 'Emmental · Langnau',
  heading = 'Oberhusers',
  doodleWord = 'Emmental',
  description = brand.description,
  ctaLabel = 'Eier-Abo bestellen',
  ctaHref = '/freilandeier',
  secondaryLabel = 'Unser Angebot',
  secondaryHref = '/#angebote',
  imageSrc = localHeroImage ?? PLACEHOLDER,
  imageAlt = 'Bauernhof im Emmental',
} = Astro.props;

const hasDoodle = doodleWord && heading.includes(doodleWord);
const headlineHtml = hasDoodle
  ? heading.replace(
      doodleWord,
      `<span class="doodle-underline">${doodleWord}</span>`,
    )
  : heading;
---

<section class="relative overflow-hidden bg-background py-12 sm:py-16 md:py-20 lg:py-24">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:gap-10">
    <!-- Copy – dominiert -->
    <div class="relative order-2 space-y-5 lg:order-1 lg:col-span-8 lg:space-y-6">
      <!-- handgezeichnetes Maskottchen / Sub-Branding -->
      <Mascot class="absolute -left-2 -top-10 hidden size-14 -rotate-12 text-terracotta lg:block" />

      {topper && (
        <span class="inline-block rounded-full bg-primary/10 px-4 py-1.5 text-topper font-bold uppercase tracking-widest text-primary">
          {topper}
        </span>
      )}

      <h1
        class="font-heading text-display font-semibold leading-[1.06] tracking-tight text-text"
        transition:name="hero-heading"
        set:html={headlineHtml}
      ></h1>

      <p class="max-w-lg text-lead text-text-muted leading-relaxed">
        {description}
      </p>

      <!-- CTA row -->
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:gap-4">
        <a
          href={ctaHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-accent px-6 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {ctaLabel}
        </a>
        <a
          href={secondaryHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-full border-2 border-primary px-6 py-3 text-base font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {secondaryLabel}
        </a>
      </div>

      <!-- Tap-to-call -->
      <a
        href={`tel:${client.phoneForTel}`}
        class="inline-flex items-center gap-2 pt-1 text-sm font-semibold text-text-muted transition-colors hover:text-primary"
      >
        <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Anrufen {client.phoneFormatted}
      </a>
    </div>

    <!-- Hero image – optionale, kleinere Bildkarte -->
    {imageSrc && (
      <div
        class="relative order-1 overflow-hidden rounded-lg shadow-xl lg:order-2 lg:col-span-4"
        transition:name="hero-image"
      >
        <Image
          src={imageSrc}
          alt={imageAlt}
          width={800}
          height={600}
          loading="eager"
          decoding="async"
          class="size-full object-cover"
        />
      </div>
    )}
  </div>
</section>
