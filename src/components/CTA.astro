---
import { client } from '../data/client';
import Huegellinie from './Huegellinie.astro';

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = 'Bald heimisches Produkt?',
  description = 'Sichere dir frische Freilandeier im Abo oder melde dein Kind für den nächsten Kindernachmittag an – wir freuen uns auf dich!',
  buttonText = 'Eier-Abo bestellen',
  buttonHref = '/freilandeier',
} = Astro.props;
---

<section class="relative overflow-hidden bg-primary py-16 sm:py-20 lg:py-24">
  <!-- Emmentaler-Hügellinie (DS §5) -->
  <div class="pointer-events-none absolute inset-x-0 top-0 -translate-y-full" aria-hidden="true">
    <Huegellinie fill="var(--color-background)" />
  </div>
  <div class="mx-auto max-w-site px-4 text-center sm:px-6">
    <h2 class="font-heading text-h2 font-semibold text-primary-fg">
      {title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-primary-fg/80 leading-relaxed">
      {description}
    </p>

    <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={buttonHref}
        class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {buttonText}
      </a>
      <a
        href={`tel:${client.phoneForTel}`}
        class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full border-2 border-primary-fg/30 px-8 py-3 text-base font-bold text-primary-fg transition-colors hover:border-primary-fg hover:bg-primary-fg/10"
      >
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Anrufen {client.phoneFormatted}
      </a>
    </div>
  </div>
</section>
