---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import AnmeldeFormular from '../../components/AnmeldeFormular.astro';
import { brand } from '../../config/brand';
import { client } from '../../data/client';
---

<BaseLayout
  title="Kontakt"
  description={`So erreichst du den ${brand.name}: Adresse, Telefon, E-Mail oder direkt über das Kontaktformular.`}
>
  <Header slot="header" />

  <Banner title="Kontakt" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-14">

      <!-- Form -->
      <div class="lg:col-span-3">
        <AnmeldeFormular
          type="kontakt"
          titel="Schreib uns"
          beschreibung="Hast du eine Frage zu unseren Produkten, dem Kindernachmittag oder einem Besuch? Wir melden uns so schnell wie möglich bei dir."
          submitLabel="Nachricht senden"
        />
      </div>

      <!-- Kontaktinfo -->
      <aside class="space-y-8 lg:col-span-2">
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Telefon</h3>
          <a href={`tel:${client.phoneForTel}`} class="mt-1 block text-primary font-medium transition-colors hover:text-primary-dark">
            {client.phoneFormatted}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">E-Mail</h3>
          <a href={`mailto:${client.email}`} class="mt-1 block text-primary font-medium transition-colors hover:text-primary-dark">
            {client.email}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Adresse &amp; Anfahrt</h3>
          <a
            href={client.address.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 block text-text-muted transition-colors hover:text-text"
          >
            {client.address.lineOne}<br />
            {client.address.zip} {client.address.city}<br />
            <span class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-primary">
              Route planen
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </span>
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Öffnungszeiten</h3>
          <p class="mt-1 text-text-muted">
            Selbstbedienung &amp; Abholung<br />
            in der Regel täglich – nach Absprache.
          </p>
          <p class="mt-2 text-sm text-text-muted">
            Am besten rufst du kurz an oder schreibst uns vor deinem Besuch.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>