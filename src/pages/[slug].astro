---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import AnmeldeFormular from '../components/AnmeldeFormular.astro';
import Icon from '../components/Icon.astro';
import Mascot from '../components/Mascot.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand } from '../config/brand';
import { client } from '../data/client';

import chicken from '../assets/images/gallery/chicken.jpg';
import cow from '../assets/images/gallery/cow.jpg';
import goat from '../assets/images/gallery/goat.jpg';
import wheat from '../assets/images/gallery/wheat.jpg';

export async function getStaticPaths() {
  const angebote = await getCollection('angebote');
  return angebote.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'angebote'> };
const { Content } = await render(entry);
const slug = entry.id;
const { data } = entry;

const covers: Record<string, ImageMetadata> = {
  freilandeier: chicken,
  milchproduktion: cow,
  kinderprogramm: goat,
  ackerbau: wheat,
};
const cover = covers[slug];

const formText: Record<string, { titel: string; beschreibung: string; submitLabel: string }> = {
  'eier-abo': {
    titel: 'Eier-Abo anfragen',
    beschreibung: 'Erzähl uns kurz, wie viele Eier du möchtest und wie du sie erhalten möchtest – wir bestätigen deine Anmeldung persönlich.',
    submitLabel: 'Eier-Abo anfragen',
  },
  'kinderprogramm': {
    titel: 'Kindernachmittag anmelden',
    beschreibung: 'Nach der Anmeldung schicken wir dir die Details zu den nächsten Kindernachmittagen und bestätigen die Teilnahme.',
    submitLabel: 'Anmeldung senden',
  },
  'b2b': {
    titel: 'Anfrage für Abnehmer',
    beschreibung: 'Wir melden uns für ein unverbindliches Gespräch zu Abnahme und Lieferung bei dir.',
    submitLabel: 'Anfrage senden',
  },
};
const form = formText[data.form];
---

<BaseLayout
  title={data.title}
  description={data.description}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${client.domain}/` },
      { '@type': 'ListItem', position: 2, name: data.title, item: `${client.domain}/${slug}/` },
    ],
  }}
>
  <Header slot="header" />

  <Banner title={data.title} />

  <!-- Intro + Bild -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="space-y-6">
        <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-topper font-bold uppercase tracking-widest text-primary">
          <Mascot class="size-5 shrink-0" />
          {data.topper}
        </span>
        <p class="text-lead text-text-muted leading-relaxed">{data.hero}</p>

        {data.highlights.length > 0 && (
          <ul class="space-y-3" role="list">
            {data.highlights.map((highlight) => (
              <li class="flex items-start gap-3">
                <Icon name="check" class="mt-0.5 size-5 shrink-0 text-terracotta" />
                <span class="text-text">{highlight}</span>
              </li>
            ))}
          </ul>
        )}

        {data.form !== 'none' && form && (
          <a
            href="#formular"
            class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-accent px-6 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90"
          >
            {form.submitLabel}
            <Icon name="arrow-down" class="size-4" />
          </a>
        )}
      </div>

      {cover && (
        <div class="overflow-hidden rounded-lg shadow-lg">
          <Image
            src={cover}
            alt={`${data.title} auf dem ${brand.name}`}
            width={800}
            height={600}
            loading="eager"
            decoding="async"
            class="size-full object-cover"
          />
        </div>
      )}
    </div>
  </section>

  <!-- Langtext -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <article class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-text prose-p:text-text-muted prose-a:text-primary prose-strong:text-text">
        <Content />
      </article>
    </div>
  </section>

  <!-- Formular -->
  {data.form !== 'none' && form && (
    <section class="py-section">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <AnmeldeFormular type={data.form} titel={form.titel} beschreibung={form.beschreibung} submitLabel={form.submitLabel} />
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BaseLayout>